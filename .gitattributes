# 统一换行符：仓库内一律 LF，检出时由 git 按平台处理
* text=auto eol=lf

# Windows 脚本保持 CRLF，避免 cmd/powershell 解析异常
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源不做文本转换、不参与 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zip  binary

# 压缩产物与生成文件在 diff 中折叠
dist/* linguist-generated=true
site.zip linguist-generated=true
